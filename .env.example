# Cloudflare API token used for `wrangler deploy` outside of CI.
# Scopes: Workers Scripts:Edit + Workers Routes:Edit on the honedtech.com zone.
# CI uses the CLOUDFLARE_API_TOKEN repository secret instead.
CLOUDFLARE_API_TOKEN=

# Turnstile widget sitekey (public). When set at build time the contact form
# renders the Turnstile widget. Locally you can use Cloudflare's visible
# always-passing TEST sitekey: 1x00000000000000000000AA
# In CI this comes from the PUBLIC_TURNSTILE_SITE_KEY repository variable.
PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Web Analytics site token (public). When set at build time every
# page renders the beacon script. Create the site under Analytics & Logs >
# Web Analytics in the Cloudflare dashboard to get the token.
# In CI this comes from the PUBLIC_CF_BEACON_TOKEN repository variable.
PUBLIC_CF_BEACON_TOKEN=
