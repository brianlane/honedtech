---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Honed Tech · Sharp tech. Clean stack. No waste.',
  description =
    'Honed Tech finds what your business is overpaying for in its tech stack, fixes it, and keeps it sharp. Tech stack audits, lean web builds, and managed retainers.',
} = Astro.props;

const logoSvg = `<svg width="26" height="26" viewBox="0 0 26 26" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M4 21 L13 3 L17 11" stroke="#2dd4bf" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/><path d="M9.5 14.5 L22 21 L4 21" stroke="#e8eef4" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>`;

const ogImage = new URL('/og.png', Astro.site);

// Cloudflare Web Analytics: the beacon renders only when the site token is
// configured at build time (locally via .env, in CI via the
// PUBLIC_CF_BEACON_TOKEN repository variable).
const beaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN as
  | string
  | undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="icon"
      href={`data:image/svg+xml,${encodeURIComponent(logoSvg)}`}
      type="image/svg+xml"
    />
    <slot name="head" />
    {beaconToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: beaconToken })}
      ></script>
    )}
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a href="/" class="logo">
          <Fragment set:html={logoSvg} />
          <span>Honed<span class="accent">Tech</span></span>
        </a>
        <nav class="site-nav">
          <a href="/#problem">The Problem</a>
          <a href="/#how-it-works">How It Works</a>
          <a href="/calculator">Calculator</a>
          <a href="/#pricing">Pricing</a>
          <a href="/#enterprise">Enterprise</a>
          <a href="/#about">About</a>
          <a href="/#contact" class="nav-cta">Book an Audit</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <form class="newsletter" method="POST" action="/api/subscribe">
          <label for="newsletter-email">
            Occasional notes on cutting tech waste. No spam.
          </label>
          <div class="newsletter-row">
            <input
              id="newsletter-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder="you@business.com"
            />
            <button type="submit" class="btn btn-primary">Subscribe</button>
          </div>
          <div class="hp" aria-hidden="true">
            <label for="newsletter-hp">Leave this field empty</label>
            <input id="newsletter-hp" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
        </form>
        <nav class="footer-nav" aria-label="Footer">
          <a href="/#how-it-works">How It Works</a>
          <a href="/calculator">Savings Calculator</a>
          <a href="/#pricing">Pricing</a>
          <a href="/#enterprise">Enterprise</a>
          <a href="/#faq">FAQ</a>
          <a href="/#contact">Book an Audit</a>
        </nav>
        <p>
          &copy; {new Date().getFullYear()} Honed Tech · Phoenix, AZ · Serving clients nationwide
          <br />
          Marketing by <a href="https://knownapex.com" rel="noopener">Known Apex</a>
        </p>
        <p class="tagline">Sharp tech. Clean stack. No waste.</p>
      </div>
    </footer>
  </body>
</html>
