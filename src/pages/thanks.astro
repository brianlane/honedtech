---
import Base from '../layouts/Base.astro';
---

<Base
  title="Request Received · Honed Tech"
  description="Your audit request has been received. We'll be in touch within one business day."
>
  <section class="util-page">
    <div class="container">
      <p class="kicker">Request Received</p>
      <h1>You&rsquo;re on the list.</h1>
      <p>
        Thanks for reaching out. We&rsquo;ll review what you sent and
        get back to you within one business day to schedule your tech stack
        audit. Keep an eye on your inbox.
      </p>
      <a href="/" class="btn btn-ghost">Back to home</a>
    </div>
  </section>
</Base>
