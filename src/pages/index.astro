---
import Base from '../layouts/Base.astro';
import { verticals } from '../data/verticals';

interface FlagshipPhase {
  num: string;
  title: string;
  body: string;
  bullets: string[];
  note?: string;
}

interface PriceItem {
  tier: string;
  price: string;
  unit: string;
  desc: string;
  featured: boolean;
  prefix?: string;
}

interface PricingTab {
  id: string;
  label: string;
  cols: string;
  note?: string;
  items: PriceItem[];
}

const description =
  'Honed Tech finds what owner-operated businesses overpay for in tech, fixes it, and builds practical AI workflows the team can use every day. AI efficiency consulting, tech stack audits, and ongoing operations.';

const principles = [
  { title: 'Audit first', body: 'See the case before you commit' },
  { title: 'Fixed scope', body: 'Clear outcomes and published entry points' },
  { title: 'Built for use', body: 'Working systems, not slide decks' },
  {
    title: 'Owner-operated businesses',
    body: 'Practical depth for teams without a full IT department',
  },
];

const briefSteps = [
  { num: '01', title: 'Map the waste', tag: 'Audit' },
  { num: '02', title: 'Build the better system', tag: 'Fix' },
  { num: '03', title: 'Keep it accountable', tag: 'Operate' },
];

const flagship: FlagshipPhase[] = [
  {
    num: '01 / MAP',
    title: 'Diagnosis and roadmap',
    body: 'Find the repetitive work, broken handoffs, missing context, and systems that create the most operational drag.',
    bullets: [
      'Workflow and tool inventory',
      'AI-readiness assessment',
      'Prioritized implementation plan',
    ],
  },
  {
    num: '02 / BUILD',
    title: 'Working stack and routines',
    body: 'Connect the right tools, ship the AI coworker, and design the human routines that make the system useful after launch.',
    bullets: [
      'Agentic workflows and integrations',
      'Intake, follow-up, and knowledge systems',
      'Team handoff and adoption support',
    ],
    note: 'Vendor products such as New Coworker may be selected when they fit the engagement.',
  },
  {
    num: '03 / STANDING TEAM',
    title: 'Ongoing AI operations',
    body: 'Keep workflows reliable, improve them with real usage, and give the business a technical partner without adding a full internal team.',
    bullets: [
      'Monitoring and maintenance',
      'Workflow iteration',
      'Vendor and adoption oversight',
    ],
  },
];

const problems = [
  {
    num: '01',
    title: 'Redundant subscriptions',
    body: 'Separate tools keep billing for capabilities included somewhere else in your stack.',
  },
  {
    num: '02',
    title: 'Oversized plans',
    body: 'Hosting, phone, scheduling, productivity, and POS plans sit above the tier your business actually uses.',
  },
  {
    num: '03',
    title: 'Overlapping SaaS',
    body: 'CRM, email, forms, and automation platforms duplicate work while scattering business data.',
  },
  {
    num: '04',
    title: 'Unquoted processing',
    body: 'Card rates renew without comparison while added fees quietly become normal.',
  },
  {
    num: '05',
    title: 'Unused AI seats',
    body: 'Proprietary AI software bills every seat while staff return to familiar spreadsheets and inboxes.',
  },
];

const steps = [
  {
    num: '01',
    meta: 'Audit',
    title: 'We find the waste',
    body: 'A full review of subscriptions, hosting, licenses, tools, and workflow friction, with a written report and prioritized next steps.',
  },
  {
    num: '02',
    meta: 'Fix',
    title: 'We eliminate it',
    body: 'Cancel what is unnecessary, migrate what is overpriced, rebuild what is broken, and implement the workflows your business actually needs.',
  },
  {
    num: '03',
    meta: 'Keep it sharp',
    title: 'We manage it going forward',
    body: 'Hosting, security, updates, optimization, vendor oversight, and AI operations stay accountable on a clear monthly retainer.',
  },
];

const pricingTabs: PricingTab[] = [
  {
    id: 'consulting',
    label: 'AI consulting',
    cols: 'grid-3',
    note: 'Final scope is defined before work starts.',
    items: [
      {
        tier: 'AI Efficiency Audit',
        price: '$999',
        unit: 'one-time',
        desc: 'Diagnosis, workflow map, and a prioritized roadmap. The full fee is credited toward an implementation.',
        featured: true,
      },
      {
        tier: 'Implementation',
        price: '$2,500-$15,000',
        unit: 'fixed-scope',
        desc: 'A defined system or set of workflows, delivered with the integrations, operating routines, and team handoff required to use it.',
        featured: false,
      },
      {
        tier: 'AI Operations',
        price: '$750',
        prefix: 'from ',
        unit: 'per month',
        desc: 'Ongoing monitoring, maintenance, iteration, vendor coordination, and adoption support after the implementation goes live.',
        featured: false,
      },
    ],
  },
  {
    id: 'audits',
    label: 'Tech stack audits',
    cols: 'grid-3',
    items: [
      {
        tier: 'Audit Snapshot',
        price: '$299',
        unit: 'one-time',
        desc: 'Full tech stack review, written report, savings estimate, and a 30-minute debrief call. The entry point for every new client.',
        featured: false,
      },
      {
        tier: 'Audit Deep Dive',
        price: '$599',
        unit: 'one-time',
        desc: 'Everything in Snapshot plus competitive benchmarking, a tool consolidation roadmap, and a full migration plan.',
        featured: true,
      },
      {
        tier: 'Audit Enterprise',
        price: '$2,499+',
        unit: 'one-time',
        desc: 'Multi-team stack and internal-tool review, license and seat utilization, AI adoption assessment, and an executive report.',
        featured: false,
      },
    ],
  },
  {
    id: 'builds',
    label: 'Web builds',
    cols: 'grid-3',
    items: [
      {
        tier: 'Web Build Starter',
        price: '$1,500-$3,500',
        unit: 'project',
        desc: 'A clean, fast site for businesses that need a professional presence without the bloat. No page builders or plugin roulette.',
        featured: false,
      },
      {
        tier: 'Web Build Custom',
        price: '$4,000-$10,000',
        unit: 'project',
        desc: 'Full custom build with integrations, booking systems, lead capture, or lightweight client portals.',
        featured: false,
      },
      {
        tier: 'Web Build Enterprise',
        price: '$10,000+',
        unit: 'project',
        desc: 'Internal tools, dashboards, and deep integrations, including replacements for software your team works around.',
        featured: false,
      },
    ],
  },
  {
    id: 'retainers',
    label: 'Monthly retainers',
    cols: 'grid-4',
    items: [
      {
        tier: 'Retainer Essential',
        price: '$499',
        unit: 'per month',
        desc: 'Hosting, uptime monitoring, security updates, and a monthly performance report.',
        featured: false,
      },
      {
        tier: 'Retainer Growth',
        price: '$999',
        unit: 'per month',
        desc: 'Everything in Essential plus SEO maintenance, Google Business optimization, and a quarterly strategy call.',
        featured: true,
      },
      {
        tier: 'Retainer Partner',
        price: '$1,800',
        unit: 'per month',
        desc: 'The managed stack: dev work, content updates, ad tech oversight, analytics, and priority support.',
        featured: false,
      },
      {
        tier: 'Retainer Enterprise',
        price: '$4,800+',
        unit: 'per month',
        desc: 'Embedded consulting, tool adoption and training, vendor management, dedicated dev capacity, and a priority SLA.',
        featured: false,
      },
    ],
  },
];

const enterpriseSteps = [
  {
    num: '01',
    title: 'Measure real adoption',
    body: 'Seat-by-seat usage, workflow failures, team fallback behavior, and the true cost per active seat.',
  },
  {
    num: '02',
    title: 'Make it stick, or prove it out',
    body: 'Training, better workflows, and a feedback pipeline that holds the vendor accountable, or a clear case for a simpler alternative.',
  },
  {
    num: '03',
    title: 'Stay embedded',
    body: 'Keep adoption measured, teams supported, and vendors accountable long after launch.',
  },
];

const fit = [
  '1-25 employees in the core small-business fit',
  'Nationwide audits, implementations, and builds',
  'Audit-first, a decision-grade case before deeper work',
  'Direct developer-level access without agency layers',
];

const aboutPoints = [
  'Audit-first, so the case comes before the build',
  'Full-stack development, not page-builder assembly',
  'Flat, published entry points with scoped project pricing',
  'Direct, no-jargon communication: advisor, not vendor',
];

const faqs = [
  {
    q: 'How much does a tech stack audit cost?',
    a: 'The Snapshot audit is a flat $299 and the Deep Dive is $599. Enterprise audits start at $2,499. Most audits pay for themselves in the first month of savings.',
  },
  {
    q: 'What do I get from an audit?',
    a: 'A written report of every subscription, license, hosting account, and tool you pay for, with monthly savings, prioritized recommendations, and a short debrief call. Delivered in days, not weeks.',
  },
  {
    q: 'Is there any obligation after the audit?',
    a: 'No. The audit stands on its own. You decide what, if anything, to fix afterward.',
  },
  {
    q: 'Do you only work with businesses in Arizona?',
    a: 'No. Honed Tech is based in the Phoenix and Scottsdale metro area but accepts audits, consulting engagements, and builds nationwide.',
  },
  {
    q: 'How is AI efficiency consulting different from the tech audit?',
    a: 'The tech audit focuses on cost, overlap, hosting, licenses, and the health of the current stack. The AI Efficiency Audit focuses on operational friction, repetitive work, intake, follow-up, and where a practical AI workflow can improve throughput. A business may need one or both.',
  },
];

// Turnstile renders only when the public sitekey is configured at build time
// (locally via .env, in CI via the PUBLIC_TURNSTILE_SITE_KEY repo variable).
// The matching TURNSTILE_SECRET_KEY Worker secret turns on server-side
// verification in /api/contact.
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as
  | string
  | undefined;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Honed Tech',
  url: 'https://honedtech.com',
  image: 'https://honedtech.com/og.png',
  description,
  slogan: 'Sharp tech. Clean stack. No waste.',
  email: 'hello@honedtech.com',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Phoenix',
    addressRegion: 'AZ',
    addressCountry: 'US',
  },
  areaServed: 'United States',
  priceRange: '$299-$15,000+',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Base title="Honed Tech · Sharp tech. Clean stack. No waste." description={description}>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(schema)}
  />
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(faqSchema)}
  />

  <section class="hero home-hero">
    <div class="container hero-layout">
      <div>
        <span class="eyebrow">Tech audits · AI systems · Ongoing operations</span>
        <h1>
          Your business is overpaying for tech. We find it, fix it, and<span class="accent"> make AI actually stick.</span>
        </h1>
        <p class="sub">
          Most owner-operated businesses carry $200-$500 per month in
          recoverable tech spend. We expose the waste, replace the friction,
          and build practical AI workflows your team can use every day.
        </p>
        <div class="cta-row">
          <a href="#consulting" class="btn btn-primary">Get the AI Efficiency Audit</a>
          <a href="#audits" class="btn btn-ghost">Start with a $299 tech audit</a>
        </div>
        <p class="proof">
          Questions first? <a href="mailto:hello@honedtech.com">hello@honedtech.com</a>
        </p>
      </div>
      <aside class="brief-panel" aria-label="Efficiency brief">
        <div class="brief-top">
          <p class="brief-label">Efficiency brief</p>
          <p class="brief-live"><span class="live-dot" aria-hidden="true"></span> Ready to map</p>
        </div>
        <p class="brief-figure">$200-$500</p>
        <p class="brief-stat">
          Typical recoverable spend per month, before workflow gains.
        </p>
        <ol class="brief-steps">
          {briefSteps.map((step) => (
            <li>
              <span class="num">{step.num}</span>
              <span class="brief-step">
                <span class="brief-step-name">{step.title}</span>
                <span class="brief-step-tag">{step.tag}</span>
              </span>
            </li>
          ))}
        </ol>
      </aside>
    </div>
  </section>

  <section class="proof-strip" aria-label="How we work">
    <div class="container proof-grid">
      {principles.map((item) => (
        <div>
          <p class="proof-title">{item.title}</p>
          <p>{item.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="consulting" class="flagship">
    <div class="flagship-ring" aria-hidden="true"></div>
    <div class="container">
      <p class="kicker">Flagship service</p>
      <div class="split-head">
        <h2>AI efficiency consulting that ends in a working system.</h2>
        <p class="section-lead">
          We help small operators stop drowning in intake and follow-up by
          shipping a working AI coworker and the routines around it, with
          optional ongoing operations.
        </p>
      </div>
      <div class="stages">
        {flagship.map((phase) => (
          <article class="stage">
            <p class="stage-num">{phase.num}</p>
            <h3>{phase.title}</h3>
            <p>{phase.body}</p>
            <ul>
              {phase.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
            {phase.note && <p class="note">{phase.note}</p>}
          </article>
        ))}
      </div>
      <div class="flagship-foot">
        <p class="flagship-close">
          The goal is not more software. It is less administrative drag, faster
          follow-through, and a stack your team understands.
        </p>
        <a href="#contact" class="btn btn-primary" data-audit="consulting">
          Discuss an AI Efficiency Audit
        </a>
      </div>
    </div>
  </section>

  <div id="problem" class="alias-anchor"></div>
  <section id="services">
    <div class="container">
      <div class="split-head">
        <div>
          <p class="kicker">The problem</p>
          <h2>Nobody is watching your tech spend. Vendors know it.</h2>
        </div>
        <p class="section-lead">
          Tools get sold, configured once, and forgotten. Meanwhile, costs
          compound and staff quietly work around systems that never earned
          adoption.
        </p>
      </div>
      <ol class="indexed-list">
        {problems.map((item) => (
          <li>
            <span class="indexed-num">{item.num}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <div id="how-it-works" class="alias-anchor"></div>
  <section id="audits">
    <div class="container how-grid">
      <div>
        <p class="kicker">How it works</p>
        <h2>Audit. Fix. Keep it sharp.</h2>
        <p class="section-lead">
          Start small and low-risk. See the savings and the operating case before
          committing to a build or ongoing support.
        </p>
      </div>
      <ol class="indexed-list how-steps">
        {steps.map((step) => (
          <li>
            <span class="indexed-num">{step.num}</span>
            <div>
              <p class="indexed-meta">{step.meta}</p>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="pricing">
    <div class="container">
      <p class="kicker">Services and pricing</p>
      <h2>Simple pricing. No surprises.</h2>
      <fieldset class="pricing-tabs">
        <legend class="sr-only">Service categories</legend>
        {pricingTabs.map((tab) => (
          <input
            class="sr-only"
            type="radio"
            name="pricing-tab"
            id={`tab-${tab.id}`}
            checked={tab.id === 'consulting'}
          />
        ))}
        <div class="pricing-tabbar">
          {pricingTabs.map((tab) => (
            <label for={`tab-${tab.id}`}>{tab.label}</label>
          ))}
        </div>
        {pricingTabs.map((tab) => (
          <div class="pricing-panel" id={`panel-${tab.id}`}>
            <div class:list={['price-board', tab.cols]}>
              {tab.items.map((item) => (
                <article class:list={['price-card', { featured: item.featured }]}>
                  <p class="price-kicker">{item.unit}</p>
                  <h3 class="price-name">{item.tier}</h3>
                  <p class="price">
                    {item.prefix && <span class="price-prefix">{item.prefix}</span>}
                    {item.price} <small>{item.unit}</small>
                  </p>
                  <p>{item.desc}</p>
                </article>
              ))}
            </div>
            {tab.note && <p class="pricing-note">{tab.note}</p>}
          </div>
        ))}
      </fieldset>
    </div>
  </section>

  <section id="enterprise">
    <div class="container enterprise-grid">
      <div>
        <p class="kicker">Enterprise AI adoption</p>
        <h2>Rolled out new software nobody uses? That is waste too.</h2>
        <p class="section-lead">
          Measure adoption, improve the operating model, or build the evidence to
          simplify. Either way, leadership gets a decision grounded in usage
          rather than rollout hype.
        </p>
        <div class="partner-lane">
          AI policy, governance, and identity and access management safeguards
          can be delivered through trusted partners when the engagement requires
          them. Honed Tech coordinates the operating fit without presenting those
          controls as a direct product.
        </div>
        <div class="cta-row enterprise-actions">
          <a href="#contact" class="btn btn-primary" data-audit="enterprise">
            Discuss an enterprise engagement
          </a>
          <a href="/enterprise" class="btn btn-ghost">Estimate your seat waste</a>
        </div>
      </div>
      <ol class="indexed-list how-steps">
        {enterpriseSteps.map((step) => (
          <li>
            <span class="indexed-num">{step.num}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="who">
    <div class="container">
      <div class="fit-band">
        <div>
          <p class="kicker">Who it is for</p>
          <h2>Owner-operated businesses with real tech spend.</h2>
          <p class="section-lead">
            If you have a digital presence and nobody on staff whose job is watching
            subscriptions, workflows, and tool adoption, Honed Tech fills the gap.
          </p>
        </div>
        <div class="fit-stats">
          {fit.map((item) => (
            <p>{item}</p>
          ))}
        </div>
      </div>
      <p class="industry-label">Industry audits</p>
      <div class="vertical-row">
        {verticals.map((v) => (
          <a class="chip" href={`/audits/${v.slug}`}>{v.name}</a>
        ))}
      </div>
    </div>
  </section>

  <section id="about">
    <div class="container">
      <div class="about-grid">
        <div>
          <p class="kicker">About</p>
          <h2>Developer-level depth. Business-owner judgment.</h2>
          <p>
            Honed Tech sits in the gap most vendors cannot fill. Web agencies
            design but rarely audit the full stack. IT firms manage
            infrastructure but often stop before the website, SaaS tools, and
            operating workflows. Marketing agencies drive traffic but cannot
            always repair the system underneath it.
          </p>
          <p>
            Honed Tech brings those layers together with full-stack development
            depth, practical vendor judgment, and a bias toward simpler systems
            that earn their cost.
          </p>
          <p>
            Based in the Phoenix and Scottsdale metro area. Audits, consulting,
            and builds accepted nationwide.
          </p>
        </div>
        <ul class="cred-list">
          {aboutPoints.map((item) => (
            <li><span class="check">✓</span> {item}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section id="faq">
    <div class="container faq-layout">
      <div>
        <p class="kicker">FAQ</p>
        <h2>Straight answers before you book.</h2>
      </div>
      <div class="faq-list">
        {faqs.map((item) => (
          <details class="faq-item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section id="contact" class="footer-band">
    <div class="container">
      <div class="footer-cta-grid">
        <div>
          <p class="kicker">Start with the friction</p>
          <h2>Find what your stack is costing you.</h2>
          <p class="email-line">
            <a href="mailto:hello@honedtech.com">hello@honedtech.com</a>
          </p>
          <form class="newsletter sharp-note" method="POST" action="/api/subscribe">
            <p class="newsletter-title">Get the sharp-stack note</p>
            <label for="sharp-note-email">
              Practical ideas for cutting software waste and making business AI useful.
            </label>
            <div class="newsletter-row">
              <input
                id="sharp-note-email"
                name="email"
                type="email"
                required
                autocomplete="email"
                placeholder="you@business.com"
              />
              <button type="submit" class="btn btn-primary">Subscribe</button>
            </div>
            <div class="hp" aria-hidden="true">
              <label for="sharp-note-hp">Leave this field empty</label>
              <input
                id="sharp-note-hp"
                name="website"
                type="text"
                tabindex="-1"
                autocomplete="off"
              />
            </div>
          </form>
        </div>

        <form class="contact-form" method="POST" action="/api/contact">
          <div class="form-intro">
            <p class="kicker" id="contact-kicker">Book an Audit</p>
            <h3 id="contact-heading">Find out what you&rsquo;re overpaying for.</h3>
            <p id="contact-blurb">
              Tell us a little about your business and we&rsquo;ll reach out
              within one business day to schedule your audit. Most clients see
              their estimated savings on the very first call.
            </p>
          </div>
          <div class="field">
            <label for="name">Your name</label>
            <input id="name" name="name" type="text" required autocomplete="name" />
          </div>
          <div class="field">
            <label for="business">Business name</label>
            <input id="business" name="business" type="text" required autocomplete="organization" />
          </div>
          <div class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" required autocomplete="email" />
          </div>
          <div class="field">
            <label for="phone">Phone <span class="opt">(optional)</span></label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" />
          </div>
          <div class="field full">
            <label for="spend">Current monthly tech spend <span class="opt">(optional, a guess is fine)</span></label>
            <select id="spend" name="spend">
              <option value="">Not sure</option>
              <option value="Under $100/mo">Under $100/mo</option>
              <option value={"$100\u2013$300/mo"}>{"$100\u2013$300/mo"}</option>
              <option value={"$300\u2013$750/mo"}>{"$300\u2013$750/mo"}</option>
              <option value={"$750\u2013$2,000/mo"}>{"$750\u2013$2,000/mo"}</option>
              <option value={"$2,000\u2013$10,000/mo"}>{"$2,000\u2013$10,000/mo"}</option>
              <option value={"$10,000\u2013$50,000/mo"}>{"$10,000\u2013$50,000/mo"}</option>
              <option value="$50,000+/mo">$50,000+/mo</option>
            </select>
          </div>
          <div class="field full">
            <label for="message"><span id="message-label">What are you paying for today?</span> <span class="opt" id="message-hint">(website, email, software, anything you know of)</span></label>
            <textarea id="message" name="message" required></textarea>
          </div>
          <input type="hidden" name="interest" id="interest" value="" />
          <div class="hp" aria-hidden="true">
            <label for="website">Leave this field empty</label>
            <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          {turnstileSiteKey && (
            <div class="field full">
              <div
                class="cf-turnstile"
                data-sitekey={turnstileSiteKey}
                data-action="turnstile-spin-v1"
                data-theme="dark"
              ></div>
            </div>
          )}
          <div class="field full">
            <button type="submit" class="btn btn-primary" style="width: 100%;" id="contact-submit">
              Request My Audit
            </button>
          </div>
        </form>
      </div>
    </div>
  </section>

  {turnstileSiteKey && (
    <script
      is:inline
      async
      defer
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    ></script>
  )}

  <!-- Swaps the contact form copy between the standard audit, the AI
       efficiency audit, and the Enterprise audit depending on which CTA the
       visitor clicked. -->
  <script is:inline>
    (() => {
      const modes = {
        default: {
          kicker: 'Book an Audit',
          heading: 'Find out what you\u2019re overpaying for.',
          blurb:
            'Tell us a little about your business and we\u2019ll reach out within one business day to schedule your audit. Most clients see their estimated savings on the very first call.',
          messageLabel: 'What are you paying for today?',
          messageHint: '(website, email, software, anything you know of)',
          submit: 'Request My Audit',
          interest: '',
          spend: null,
        },
        consulting: {
          kicker: 'AI Efficiency Audit',
          heading: 'Map the drag before you build.',
          blurb:
            'Tell us where work piles up and we will reach out within one business day to scope an AI Efficiency Audit. The full fee is credited toward an implementation.',
          messageLabel: 'Where does repetitive work pile up?',
          messageHint: '(intake, follow-up, handoffs, tools the team actually uses)',
          submit: 'Request an AI Efficiency Audit',
          interest: 'AI Efficiency Audit',
          spend: null,
        },
        enterprise: {
          kicker: 'Book an Enterprise Audit',
          heading: 'Find out what that rollout is really costing.',
          blurb:
            'Tell us about your team and the software you\u2019ve rolled out. We\u2019ll reach out within one business day to scope an adoption audit: usage, training gaps, and what it should really cost.',
          messageLabel: 'What did you roll out, and what\u2019s not sticking?',
          messageHint: '(the software, team size, and what staff use instead)',
          submit: 'Request Enterprise Audit',
          interest: 'Enterprise',
          spend: '$2,000\u2013$10,000/mo',
        },
        calculator: {
          kicker: 'Book an Audit',
          heading: 'Let\u2019s recover what the calculator found.',
          blurb:
            'Your estimate is below. Send it over and we\u2019ll confirm the exact savings with a full audit, usually on the first call.',
          messageLabel: 'What are you paying for today?',
          messageHint: '(prefilled from your calculator results, edit freely)',
          submit: 'Request My Audit',
          interest: 'Calculator',
          spend: null,
        },
      };

      const el = (id) => document.getElementById(id);
      const setMode = (name) => {
        const m = modes[name];
        el('contact-kicker').textContent = m.kicker;
        el('contact-heading').textContent = m.heading;
        el('contact-blurb').textContent = m.blurb;
        el('message-label').textContent = m.messageLabel;
        el('message-hint').textContent = m.messageHint;
        el('contact-submit').textContent = m.submit;
        el('interest').value = m.interest;
        const spend = el('spend');
        if (m.spend) {
          spend.value = m.spend;
        } else if (spend.value === modes.enterprise.spend) {
          spend.value = '';
        }
      };

      document
        .querySelectorAll('a[href="#contact"], a[href="/#contact"]')
        .forEach((a) => {
          a.addEventListener('click', () => {
            const mode = a.dataset.audit;
            setMode(mode && modes[mode] ? mode : 'default');
          });
        });

      // Prefill the interest field and a message stub when a visitor arrives
      // from a vertical landing page (/?v=slug#contact). The slug is a
      // human-readable label after replacing hyphens with spaces.
      const v = new URLSearchParams(location.search).get('v');
      if (v) {
        const label = v.replace(/-/g, ' ');
        el('interest').value = `Vertical: ${label}`;
        const message = el('message');
        if (message instanceof HTMLTextAreaElement && !message.value) {
          message.value = `I run a ${label} business. `;
        }
      }

      // Prefill from either estimator, which stashes a message in
      // sessionStorage before sending the visitor here. The enterprise key is
      // checked first and keeps the enterprise copy, since that visitor is
      // answering a different question than the savings calculator asks.
      const entMsg = sessionStorage.getItem('honed_enterprise_msg');
      const calcMsg = sessionStorage.getItem('honed_calc_msg');
      if (entMsg || calcMsg) {
        sessionStorage.removeItem('honed_enterprise_msg');
        sessionStorage.removeItem('honed_calc_msg');
        setMode(entMsg ? 'enterprise' : 'calculator');
        const message = el('message');
        if (message instanceof HTMLTextAreaElement) {
          message.value = entMsg || calcMsg || '';
        }
      }
    })();
  </script>
</Base>
