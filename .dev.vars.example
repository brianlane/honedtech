# Local Worker secrets for `wrangler dev` / `astro dev`. Copy to .dev.vars.
# Turnstile secret key. The default below is Cloudflare's official
# always-passing TEST secret; pair it with the test sitekey. Production uses
# `wrangler secret put TURNSTILE_SECRET_KEY` with the real widget secret.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
